# Copy to .env and fill in real values. .env is never committed.

PORT=3000

# PostgreSQL (docker-compose reads these)
POSTGRES_USER=farm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farm_management
POSTGRES_PORT=5432

# Prisma / API
DATABASE_URL=postgresql://farm:change-me@localhost:5432/farm_management

# Sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me

# Seed (scripts/seed.ts): initial organization + owner user
SEED_ORG_NAME=My Farm
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me
SEED_OWNER_NAME=Owner
