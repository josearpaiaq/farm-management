# Copy to .env and fill in real values. .env is never committed.

PORT=3000

# PostgreSQL (docker-compose reads these)
POSTGRES_USER=farm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farm_management
POSTGRES_PORT=5432

# Prisma / API
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me

# Seed (scripts/seed.ts): initial organization + owner user
SEED_ORG_NAME=My Farm
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me
SEED_OWNER_NAME=Owner

# Email (Resend). Leave RESEND_API_KEY empty locally: codes are printed
# to the API console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Farm Management <onboarding@resend.dev>
