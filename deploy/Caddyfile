# Caddy obtains and renews the HTTPS certificate for DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# One canonical origin: the session cookie and the installed PWA are tied
# to it, so www only redirects (it needs its own DNS record).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
